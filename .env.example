# Copy to .env and adjust. All settings can also be passed as env vars with the KB_ prefix.

KB_DB_DSN=postgresql://okb:okb@127.0.0.1:15432/okb
KB_DATA_DIR=~/kb-data

# Inference endpoints (vLLM on gx10-2)
KB_GEN_URL=http://10.66.66.15:8000/v1
KB_GEN_MODEL=nvidia/Qwen3.6-35B-A3B-NVFP4
KB_EMB_URL=http://10.66.66.15:8001/v1
KB_EMB_MODEL=Qwen/Qwen3-Embedding-8B

# Embedding dim after MRL truncation (Qwen3-Emb-8B native = 4096; pgvector HNSW max = 2000)
KB_EMB_DIM=1536

# Concurrency of in-flight LLM requests per worker
KB_CONCURRENCY=16

# MCP server
KB_MCP_HOST=0.0.0.0
KB_MCP_PORT=17000
